{
  "name": "speakslow",
  "version": "1.0.22",
  "description": "聲聲慢 SpeakSlow - 專為中文打造、最快的本地語音輸入（sherpa-onnx）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node start-electron.js",
    "dev": "concurrently -k -r \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:main": "cross-env NODE_ENV=development electronmon .",
    "dev:renderer": "cd src && vite",
    "build": "npm run prepare:models && cd src && vite build && cd .. && electron-builder",
    "build:renderer": "cd src && vite build",
    "prepare:models": "node scripts/prepare-models.mjs",
    "prepare:python": "pip install -r requirements.txt && python download_all_models.py",
    "prepare:python:mac": "if [ ! -x .venv/bin/python ]; then python3 -c 'import sys; assert (3, 10) <= sys.version_info[:2] <= (3, 12)' || { echo 'Python 3.10-3.12 is required to create the macOS build environment.' >&2; exit 1; }; python3 -m venv .venv; fi && if ! ./.venv/bin/python -c 'import sys, pip; assert (3, 10) <= sys.version_info[:2] <= (3, 12)' >/dev/null 2>&1; then echo 'Existing .venv is not Python 3.10-3.12 with pip; remove it manually and rerun.' >&2; exit 1; fi && ./.venv/bin/python -m pip install --upgrade pip && ./.venv/bin/python -m pip install -r requirements.txt && ./.venv/bin/python download_all_models.py",
    "build:backend": "node scripts/build-backend.mjs",
    "build:backend:mac": "npm run build:backend",
    "build:win": "npm run prepare:models && electron-builder --win",
    "dist:win": "npm run prepare:models && npm run build:backend && npm run build:renderer && electron-builder --win",
    "build:mac": "npm run prepare:python:mac && npm run build:backend:mac && npm run build:renderer && electron-builder --mac --arm64 --publish never",
    "dist:mac": "npm run build:mac",
    "lint": "cd src && eslint .",
    "preview": "cd src && vite preview",
    "clean": "node cleanup.js && rm -rf python build_pyi"
  },
  "electronmon": {
    "patterns": [
      "!dist/**",
      "!src/dist/**",
      "!package-lock.json",
      "!build_pyi/**",
      "!build/**",
      "!web/**",
      "!poc-sherpa/**",
      "!assets/logo-build/**",
      "!.venv/**"
    ]
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "sherpa-onnx",
    "ai",
    "voice-input",
    "chinese",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "Jeffrey0117"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
    "@eslint/js": "^9.25.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electronmon": "^2.0.4",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "node-gyp": "^13.1.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^16.3.1",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "opencc-js": "^1.4.2",
    "osascript": "^1.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "com.speakslow.app",
    "productName": "SpeakSlow",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "sherpa_server.py",
      "text_processing.py",
      "package.json",
      "node_modules/**/*",
      "src/dist/**/*",
      "src/helpers/**/*",
      "src/utils/**/*",
      "assets/**/*",
      "!node_modules/.cache/**/*",
      "!src/node_modules/**/*"
    ],
    "asarUnpack": [
      "sherpa_server.py",
      "text_processing.py",
      "node_modules/**/*better-sqlite3*/**/*"
    ],
    "extraResources": [
      {
        "from": "build_pyi/dist/sherpa_server",
        "to": "sherpa-backend"
      },
      {
        "from": "poc-sherpa/sherpa-onnx-paraformer-zh-2023-09-14",
        "to": "sherpa-backend/poc-sherpa/sherpa-onnx-paraformer-zh-2023-09-14"
      },
      {
        "from": "poc-sherpa/sherpa-onnx-paraformer-zh-small-2024-03-09",
        "to": "sherpa-backend/poc-sherpa/sherpa-onnx-paraformer-zh-small-2024-03-09"
      },
      {
        "from": "poc-sherpa/sherpa-onnx-punct-ct-transformer-zh-en-vocab272727-2024-04-12",
        "to": "sherpa-backend/poc-sherpa/sherpa-onnx-punct-ct-transformer-zh-en-vocab272727-2024-04-12"
      },
      {
        "from": "poc-sherpa/silero_vad.onnx",
        "to": "sherpa-backend/poc-sherpa/silero_vad.onnx"
      },
      {
        "from": "poc-sherpa/sherpa-onnx-streaming-zipformer-bilingual-zh-en-2023-02-20",
        "to": "sherpa-backend/poc-sherpa/sherpa-onnx-streaming-zipformer-bilingual-zh-en-2023-02-20"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "聲聲慢",
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Office",
      "artifactName": "${productName}.${ext}",
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "${productName}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ]
    }
  }
}
